{
  "env": {
    "ZDOTDIR": ".claude"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(awk *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(zsh *)",
      "Read(**/Projects/ai-starter-pack/**)",
      "Edit(**/Projects/ai-starter-pack/**)"
    ],
    "deny": ["Read(./legacy/**)"]
  },
  "enabledPlugins": {
    "comlia-skills@comlia-skills": false
  }
}
